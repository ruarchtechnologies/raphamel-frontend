# ── Raphamel Frontend — Environment Variables ─────────────────────────────────
#
# Copy this file to the env file for your target environment:
#   Local dev  →  .env.local
#   Staging    →  .env.staging
#   Production →  .env.production
#
# Files named .env.local / .env.staging / .env.production are gitignored.
# NEVER commit real keys. NEVER commit anything other than .env.example.
#
# NEXT_PUBLIC_* vars are inlined into the browser bundle at build time.
# Vars without NEXT_PUBLIC_ are server-only (middleware, API routes, etc.)
# ─────────────────────────────────────────────────────────────────────────────

# ── Medusa backend ────────────────────────────────────────────────────────────
# Local:      http://localhost:9000
# Staging:    https://staging-api.raphamel.health
# Production: https://api.raphamel.health
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable API key — found in Medusa Admin → Settings → API Keys
# Each environment (local / staging / prod) has its own key.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Paystack ──────────────────────────────────────────────────────────────────
# Local + Staging: use pk_test_... key
# Production:      use pk_live_... key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Waitlist (Google Sheets webhook) ─────────────────────────────────────────
# Google Apps Script Web App URL.
# Receives POST { email, timestamp } and writes to Google Sheets.
# Deploy your Apps Script and paste the /exec URL here.
NEXT_PUBLIC_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# ── Feature flags ─────────────────────────────────────────────────────────────
# WAITLIST_MODE=true  → redirects every route to /waitlist (pre-launch gate)
# WAITLIST_MODE=false → normal storefront (default)
WAITLIST_MODE=false
