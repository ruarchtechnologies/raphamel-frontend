{
  "name": "raphamel-marketplace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:staging": "dotenv -e .env.staging -- next dev",
    "build": "next build",
    "build:staging": "dotenv -e .env.staging -- next build",
    "build:prod": "dotenv -e .env.production -- next build",
    "build:cf": "dotenv -e .env.production -- yarn next-on-pages",
    "build:cf:staging": "dotenv -e .env.staging -- yarn next-on-pages",
    "build:cf:local": "yarn next-on-pages",
    "preview": "yarn wrangler pages dev .vercel/output/static",
    "preview:staging": "dotenv -e .env.staging -- yarn wrangler pages dev .vercel/output/static",
    "start": "next start",
    "start:staging": "dotenv -e .env.staging -- next start",
    "lint": "next lint",
    "typecheck": "yarn tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "postinstall": "node scripts/patch-next-lockfile.mjs"
  },
  "dependencies": {
    "@headlessui/react": "^2.0.0",
    "@hookform/resolvers": "^3.3.4",
    "@medusajs/js-sdk": "^2.13.5",
    "@medusajs/types": "^2.13.5",
    "@paystack/inline-js": "^2.22.8",
    "@radix-ui/react-slot": "^1.0.2",
    "@tanstack/react-query": "^5.28.0",
    "@tanstack/react-query-devtools": "^5.28.0",
    "axios": "^1.6.8",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.0.0",
    "embla-carousel-react": "^8.0.0",
    "framer-motion": "^11.0.8",
    "lucide-react": "^0.368.0",
    "next": "16.2.2",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.51.0",
    "sonner": "^1.4.3",
    "tailwind-merge": "^2.2.2",
    "zod": "^3.22.4",
    "zustand": "^4.5.2"
  },
  "resolutions": {
    "glob": "^10.4.5"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.0.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8",
    "eslint-config-next": "16.2.2",
    "jsdom": "^29.0.2",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.4",
    "wrangler": "^4.75.0"
  }
}
